{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "preserve",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "exactOptionalPropertyTypes": false,
    "useDefineForClassFields": true,
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "incremental": true,
    "types": ["node", "@webgpu/types"],
    "baseUrl": ".",
    "paths": {
      "@neuroforge/shared": ["packages/shared/src/index.ts"],
      "@neuroforge/shared/*": ["packages/shared/src/*"],
      "@neuroforge/math": ["packages/math/src/index.ts"],
      "@neuroforge/math/*": ["packages/math/src/*"],
      "@neuroforge/shaders": ["packages/shaders/src/index.ts"],
      "@neuroforge/shaders/*": ["packages/shaders/src/*"],
      "@neuroforge/simulation": ["packages/simulation/src/index.ts"],
      "@neuroforge/simulation/*": ["packages/simulation/src/*"],
      "@neuroforge/renderer": ["packages/renderer/src/index.ts"],
      "@neuroforge/renderer/*": ["packages/renderer/src/*"],
      "@neuroforge/physics": ["packages/physics/src/index.ts"],
      "@neuroforge/physics/*": ["packages/physics/src/*"],
      "@neuroforge/editor": ["packages/editor/src/index.ts"],
      "@neuroforge/editor/*": ["packages/editor/src/*"],
      "@neuroforge/io": ["packages/io/src/index.ts"],
      "@neuroforge/io/*": ["packages/io/src/*"],
      "@neuroforge/ai": ["packages/ai/src/index.ts"],
      "@neuroforge/ai/*": ["packages/ai/src/*"],
      "@neuroforge/ui": ["packages/ui/src/index.ts"],
      "@neuroforge/ui/*": ["packages/ui/src/*"]
    }
  },
  "exclude": ["node_modules", "**/dist", "**/.next", "**/out"]
}
